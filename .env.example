# Public endpoints only. Provider credentials live server-side in remnant-academy.
# Production builds read .env.production; override here only to point a local
# build at a different academy deployment (e.g. a Vercel preview URL).
VITE_ACADEMY_URL=https://academy.remnantsecurity.com
VITE_WAITLIST_API_URL=https://academy.remnantsecurity.com/api/waitlist
VITE_CAREER_PLAN_API_URL=https://academy.remnantsecurity.com/api/career-plan
